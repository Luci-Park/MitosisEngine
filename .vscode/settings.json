{
    "files.associations": {
        "*.tmpl": "plaintext"
    },
    "cmake.useVsDeveloperEnvironment": "always",
    "files.watcherExclude": {
        "**/builds/**": true,
        "**/logs/**": true
    },
    "search.exclude": {
        "**/builds/**": true,
        "**/logs/**": true
    },
    "C_Cpp.files.exclude": {
        "**/builds/**": true,
        "**/logs/**": true,
        "**/.git/**": true
    },
    "C_Cpp.intelliSenseEngineFallback": "disabled",
    "C_Cpp.autocompleteAddParentheses": true,
    // Throttle background workspace parsing so it does not compete with
    // the IntelliSense process for the open file.
    "C_Cpp.workspaceParsingPriority": "medium",
    "C_Cpp.intelliSenseCacheSize": 8192
}